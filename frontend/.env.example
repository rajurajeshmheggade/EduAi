# Optional landing-page contact banner (hidden when both are empty)
VITE_SALES_EMAIL=
VITE_SALES_PHONE=
# Dev proxy target for the API (default http://127.0.0.1:8000)
# VITE_API_TARGET=http://127.0.0.1:8000
# Production on a static host (Vercel): backend origin for direct API calls, no trailing slash. Leave empty to call the
# API on the same origin through the host's rewrites (frontend/vercel.json). See docs/DEPLOY_VERCEL.md.
# VITE_API_BASE_URL=https://api.example.com
