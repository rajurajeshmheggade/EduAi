# Copy to .env (repo root) or backend/.env — placeholders only. In production inject from Azure Key Vault.

ENVIRONMENT=development
# mock   = fully offline (fake embeddings + extractive answers), no keys needed
# azure  = Azure OpenAI (fill the AZURE_OPENAI_* block)
# openai = OpenAI API   (fill the OPENAI_* block)
PROVIDER_MODE=mock
CORS_ORIGINS=http://localhost:5173

# Leave DATABASE_URL empty in dev to use the bundled local PostgreSQL 16 + pgvector (python -m app.devdb start).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/eduai?sslmode=require
DATABASE_URL=

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Empty = run background jobs on an in-process thread. Set for Celery + Redis workers.
REDIS_URL=

STORAGE_MODE=local
PUBLIC_BASE_URL=http://localhost:8000
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=eduai

# ---- AI keys: Azure OpenAI (PROVIDER_MODE=azure) ----
# Endpoint looks like https://<resource>.openai.azure.com/ ; *_DEPLOYMENT = your deployment names.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
# Chat / vision model used for OCR + grading (AZURE_OPENAI_MODEL_DEPLOYMENT is accepted too)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
# Optional: embedding model in a different Azure resource (leave empty to reuse the key/endpoint above)
AZURE_OPENAI_EMBEDDING_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_VERSION=

# ---- AI keys: OpenAI (PROVIDER_MODE=openai) ----
OPENAI_API_KEY=
# Optional: OpenAI-compatible gateway URL; leave empty for api.openai.com
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_WHISPER_MODEL=whisper-1

# ---- AI answer-script evaluation ----
# Handwritten/scanned scripts are rendered at this DPI for GPT-4o vision OCR (typed PDFs need no AI for reading)
EVAL_OCR_DPI=300
EVAL_OCR_PAGES_PER_CALL=6
EVAL_MAX_SCRIPT_PAGES=40
EVAL_MAX_SCRIPT_MB=40

# Attendance: default % below which a student is flagged as a defaulter (each institution can override)
ATTENDANCE_THRESHOLD=75

# ---- Lesson Plan → Session Plan content agents (Current Affairs / Video References / Images / Documents) ----
# Generation itself runs on the AI provider above. These keys feed the live blocks spliced into each session:
#   Images: SerpAPI google_images → Wikimedia Commons → Openverse · Videos: YouTube Data API v3 → SerpAPI youtube
#   Current affairs: SerpAPI google_news → Wikinews · Documents: SerpAPI google + filetype:pdf|doc|docx (NCERT/DIKSHA)
# An empty key just drops that source from the chain; a block with no source says so on the Session Plan screen.
SERPAPI_API_KEY=
YOUTUBE_API_KEY=
SESSION_AGENTS_TIMEOUT_SECONDS=45
SESSION_AGENTS_CACHE_MINUTES=360
SESSION_AGENTS_PREFER_FREE_SOURCES=false
# DuckDuckGo answers 403 on many school networks — enable only where duckduckgo.com is reachable
SESSION_AGENTS_ENABLE_WEB_FALLBACK=false
# Optional: the Python LessonPlanApi agent service (its /search-images answers Images when set)
SESSION_AGENTS_BASE_URL=
